{
  "dataRoles": [
    {
      "displayName": "Category",
      "displayNameKey": "Visual_DataRole_Group",
      "name": "group",
      "kind": "Grouping",
      "description": "Primary category shown on X-axis (e.g., region, product line, department)"
    },
    {
      "displayName": "Sub-Category",
      "displayNameKey": "Visual_DataRole_Year",
      "name": "year",
      "kind": "Grouping",
      "description": "Secondary category compared side-by-side within each group (e.g., year, quarter, scenario)"
    },
    {
      "displayName": "Stack Segment",
      "displayNameKey": "Visual_DataRole_Location",
      "name": "location",
      "kind": "Grouping",
      "description": "Breakdown dimension stacked within each bar (e.g., province, product, team)"
    },
    {
      "displayName": "Value",
      "displayNameKey": "Visual_DataRole_Value",
      "name": "value",
      "kind": "Measure",
      "description": "Numeric value for each segment"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Visual_DataRole_Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Additional measures shown in the tooltip"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "group": { "max": 1 },
          "year": { "max": 1 },
          "location": { "max": 1 },
          "value": { "max": 1 },
          "tooltips": { "max": 5 }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            { "for": { "in": "group" } },
            { "for": { "in": "year" } },
            { "for": { "in": "location" } }
          ],
          "dataReductionAlgorithm": { "top": {} }
        },
        "values": {
          "select": [
            { "for": { "in": "value" } },
            { "for": { "in": "tooltips" } }
          ]
        }
      }
    }
  ],
